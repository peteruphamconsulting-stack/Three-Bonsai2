\section{Explicit prime-sum bounds for the packing criteria}\label{app:tail}

For the prime-sum quantity used in the rectangle continuation and in the convex-body tails, the earlier explicit estimates give, for every prime $q\ge X_1=10^{7}$,
\begin{equation}\label{eq:tailgoal}
\rho(q)\;=\;\frac{3T(q)+r}{\sqrt{q\,R_{<q}}}\;<\;0.614,\qquad r=\sqrt2 .
\end{equation}
The two inputs are the explicit Mertens bounds of Rosser--Schoenfeld and the explicit Chebyshev bound of
Dusart. Write $\gamma$ for the Euler--Mascheroni constant, $e^{-\gamma}=0.561459\ldots$, and
$M(x)=\prod_{p\le x}(1-1/p)$.

\medskip
\noindent\textbf{Inputs.}
\begin{align}
\text{(RS)}\quad& \frac{e^{-\gamma}}{\ln x}\Bigl(1-\tfrac1{\ln^2x}\Bigr)\;\le\;M(x)\;\le\;
      \frac{e^{-\gamma}}{\ln x}\Bigl(1+\tfrac1{\ln^2x}\Bigr) &&(x\ge285),\\[2pt]
\text{(Du)}\quad& \pi(x)\;\le\;\frac{x}{\ln x}\Bigl(1+\frac{1.2762}{\ln x}\Bigr) &&(x\ge Q_1).
\end{align}
(RS) is Rosser--Schoenfeld \cite{RosserSchoenfeld}, and (Du) is Dusart \cite{Dusart}. Set $Q_1=10^{5}$,
$\ell:=\ln Q_1=11.5129\ldots$, and $\beta:=e^{-\gamma}\bigl(1-\ell^{-2}\bigr)=0.55722\ldots$

\medskip
\noindent\textbf{Step 1 (lower bound on $R_{<q}$).}
For prime $q$, $R_{<q}=\prod_{p<q}(1-1/p)=M(q)\,\frac{q}{q-1}\ge M(q)$, so by (RS), for $q\ge Q_1$,
\begin{equation}\label{eq:Rlow}
R_{<q}\;\ge\;\frac{e^{-\gamma}}{\ln q}\Bigl(1-\tfrac1{\ln^2q}\Bigr)\;\ge\;\frac{\beta}{\ln q}.
\end{equation}

\noindent\textbf{Step 2 (pointwise bound on $\sqrt{d_p}$).}
Again $R_{<p}=M(p)\,\frac{p}{p-1}$, so by the upper half of (RS), for $p\ge Q_1$,
\[
\sqrt{d_p}=\sqrt{\frac{R_{<p}}{p}}
   \le\frac{e^{-\gamma/2}}{\sqrt{p\ln p}}\sqrt{\Bigl(1+\tfrac1{\ln^2p}\Bigr)\tfrac{p}{p-1}}
   \le\frac{1.004\,e^{-\gamma/2}}{\sqrt{p\ln p}},
\]
the last step since the product is dominated by the Mertens factor:
$\bigl(1+\ell^{-2}\bigr)\tfrac{Q_1}{Q_1-1}=1.00755\cdot1.00001\le1.004^2$ (the large factor is
$1+1/\ln^2 Q_1$, not the negligible $Q_1/(Q_1-1)=1.00001$).

\noindent\textbf{Step 3 (partial summation).}
Let $h(t)=(t\ln t)^{-1/2}$, so $|h'(t)|=\tfrac12 t^{-3/2}(\ln t)^{-1/2}(1+1/\ln t)$, and
$U(q):=\sum_{Q_1<p\le q}h(p)$. By Abel summation and (Du),
\[
U(q)\le h(q)\pi(q)+\int_{Q_1}^{q}\pi(t)\,|h'(t)|\,dt
     \le \sqrt q\,(\ln q)^{-3/2}\Bigl(1+\tfrac{1.2762}{\ln q}\Bigr)
        +\tfrac12 F\!\int_{Q_1}^{q}\! t^{-1/2}(\ln t)^{-3/2}\,dt,
\]
where $F:=\bigl(1+\tfrac{1.2762}{\ell}\bigr)\bigl(1+\tfrac1{\ell}\bigr)=1.2073$ bounds
$(1+\tfrac{1.2762}{\ln t})(1+\tfrac1{\ln t})$ for $t\ge Q_1$. For the integral, from
$\frac{d}{dt}\bigl[2t^{1/2}(\ln t)^{-3/2}\bigr]=t^{-1/2}(\ln t)^{-3/2}\bigl(1-\tfrac3{\ln t}\bigr)$
and $(\ln t)^{-5/2}\le\ell^{-1}(\ln t)^{-3/2}$ one gets, with $G:=(1-3/\ell)^{-1}=1.3524$,
\begin{equation}\label{eq:intbd}
\int_{Q_1}^{q} t^{-1/2}(\ln t)^{-3/2}\,dt\;\le\;2G\,\sqrt q\,(\ln q)^{-3/2}.
\end{equation}
Hence $U(q)\le\bigl(1+\tfrac{1.2762}{\ell}+FG\bigr)\sqrt q\,(\ln q)^{-3/2}=2.7436\,\sqrt q\,(\ln q)^{-3/2}$, and with
Step 2,
\[
\sum_{Q_1<p\le q}\sqrt{d_p}\;\le\;1.004\,e^{-\gamma/2}\,U(q)\;\le\;K\,\sqrt q\,(\ln q)^{-3/2},
\qquad K:=1.004\,e^{-\gamma/2}\cdot2.7436=2.0641 .
\]
Therefore, writing $A(q):=T(q)(\ln q)^{3/2}/\sqrt q$,
\begin{equation}\label{eq:Abd}
A(q)\;\le\;T(Q_1)\,\frac{(\ln q)^{3/2}}{\sqrt q}\;+\;K
\qquad(q\ge Q_1),\qquad T(Q_1)=18.906 .
\end{equation}
The right side of \eqref{eq:Abd} is decreasing for $q\ge e^{3}$, so evaluating at $X_1=10^{7}$ gives
$A(q)\le A(X_1)\le2.4509$ for all $q\ge X_1$.

\noindent\textbf{Step 4 (assembly).} Using $T(q)=A(q)\sqrt q\,(\ln q)^{-3/2}$ and \eqref{eq:Rlow},
\[
\rho(q)=\frac{3T(q)+r}{\sqrt{q\,R_{<q}}}
   \le\frac{3A(q)}{\sqrt\beta\,\ln q}+\frac{r\sqrt{\ln q}}{\sqrt\beta\,\sqrt q}
   \qquad(q\ge Q_1).
\]
Both terms decrease for $q\ge X_1$; at $q=X_1$ they are $0.61112$ and $0.00241$, summing to $0.61353$, so
$\rho(q)<0.614$ for all $q\ge X_1$, which is \eqref{eq:tailgoal}. Combined with the interval evaluations on the finite ranges, this yields the explicit auxiliary majorants used in the rectangle continuation proof. \qed

\medskip
\noindent\textbf{Two further bounds for the rectangle continuation.}
For primes $q\ge X_1=10^7$, the lower Mertens estimate \eqref{eq:Rlow} and Dusart's bound give
\[
\frac1{\sqrt{qR_{<q}}}\le
\sqrt{\frac{\ln q}{\beta q}}
\le\sqrt{\frac{\ln X_1}{\beta X_1}}<0.00171,
\qquad
\frac{N_q}{q}\le\frac{\pi(q)}q
\le\frac{1+1.2762/\ln X_1}{\ln X_1}<0.0670.
\]
Both displayed majorants decrease for $q\ge X_1$. Together with \eqref{eq:tailgoal} they give the
infinite-range rectangle criterion bound stated in Theorem~\ref{thm:rect}; its finite predecessor window
is checked separately through $10^7$ by the rectangle interval verifier.

\medskip
\noindent All constants above are reproduced by the companion code \cite{Code} (\texttt{python rect\_exact.py
tail}), which also verifies the two finite windows in interval arithmetic and confirms that the explicit
majorant \eqref{eq:Abd} dominates the true $A(q)$ throughout $[Q_1,X_1]$.

